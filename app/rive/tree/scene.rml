<Rive version="1" kind="fragment">
    <!--
      The tree, split into FIVE depth layers, each its own artboard.

      All five share the same 400 x 560 coordinate space, so stacking them
      unshifted reproduces the single-artboard tree exactly. Dart then offsets
      each layer by an amount proportional to its depth as the user rotates,
      which is what produces parallax. See lib/ui/tree/tree_scene.dart.

      WHY SEPARATE ARTBOARDS
      A single artboard cannot parallax: its shapes are baked into one draw. One
      file with five artboards keeps a single asset and a single FileLoader while
      letting Dart position each layer, selected with
      ArtboardSelector.byName('TreeFront') and so on.

      LAYER ORDER, back to front, which is the order Dart must stack them:
        TreeGround  depth 0.00   moves least, the anchor the eye trusts
        TreeBack    depth 0.20   dim, occluded by the trunk
        TreeMid     depth 0.45   the branches most fruit hang on
        TreeTrunk   depth 0.65   the pivot: at rest it does not move
        TreeFront   depth 1.00   lightest, thickest, moves most

      Within each artboard, draw order still runs FRONT to BACK: the first shape
      declared paints on top.

      DEPTH, NOT 3D. No geometry anywhere. Volume comes from a trunk that holds
      its width and flares only at the base, a LinearGradient running ACROSS the
      trunk so it reads cylindrical, branches leaving at five different heights,
      tips that taper to points, and the trunk occluding what is behind it.

      No Artboard Fill on any layer: they composite over each other and over
      Ludeck's canvas. A fill would punch a dark rectangle through the stack.

      Colours are Ludeck's six and nothing else, from lib/ui/tokens.dart:
        surface FF181A1D   textDim FF8B9099   accent FFE8B84B
      Luminance steps between those two greys are not new colours. A brown or a
      green would be, which is why this tree reads as carved rather than
      naturalistic. That is a consequence of the palette, not a compromise.
    -->

    <!-- ================= LAYER 5: FRONT ================= -->
    <Artboard defaultStateMachineId="1:7" styleId="1:5" width="400" height="560" name="TreeFront" id="1:2">
        <LayoutComponentStyle name="Style" id="1:5"/>

        <!-- The low wide sweep. Thickest and lightest, and the one that carries
             the eye outward. Reaches furthest because near things do. -->
        <Shape x="200" y="0" name="BranchFrontLeft" id="1:30">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="-18"  y="356" radius="2"/>
                <StraightVertex x="-78"  y="334" radius="10"/>
                <StraightVertex x="-134" y="300" radius="10"/>
                <StraightVertex x="-170" y="258" radius="4"/>
                <StraightVertex x="-166" y="252" radius="4"/>
                <StraightVertex x="-124" y="288" radius="10"/>
                <StraightVertex x="-70"  y="318" radius="10"/>
                <StraightVertex x="-15"  y="336" radius="2"/>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="-172" startY="256" endX="-14" endY="356" name="Gradient">
                    <GradientStop colorValue="FF8B9099" position="0"/>
                    <GradientStop colorValue="FF474B52" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <!-- Higher and shorter than its opposite. A symmetric tree reads as a
             logo, so the two sides are deliberately not mirrors. -->
        <Shape x="200" y="0" name="BranchFrontRight" id="1:32">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="18"  y="318" radius="2"/>
                <StraightVertex x="76"  y="292" radius="10"/>
                <StraightVertex x="126" y="252" radius="10"/>
                <StraightVertex x="156" y="208" radius="4"/>
                <StraightVertex x="152" y="202" radius="4"/>
                <StraightVertex x="116" y="240" radius="10"/>
                <StraightVertex x="68"  y="276" radius="10"/>
                <StraightVertex x="15"  y="298" radius="2"/>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="158" startY="206" endX="14" endY="318" name="Gradient">
                    <GradientStop colorValue="FF8B9099" position="0"/>
                    <GradientStop colorValue="FF474B52" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <LinearAnimation duration="60" name="Idle" id="1:6"/>
        <StateMachine name="SM" id="1:7">
            <StateMachineLayer name="Layer" id="1:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="1:12"/></EntryState>
                <AnimationState x="200" animationId="1:6" id="1:12"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- ================= LAYER 4: TRUNK (the pivot) ================= -->
    <Artboard defaultStateMachineId="2:7" styleId="2:5" width="400" height="560" name="TreeTrunk" id="2:2">
        <LayoutComponentStyle name="Style" id="2:5"/>

        <!-- Nearly parallel from the top down to y=390, then flaring into the
             ground. Half-width 9 at the top, 19 through the middle, 32 at the
             base. An earlier version tapered linearly the whole way and read as
             a traffic cone; trees hold their width and flare into the roots.

             The centre line drifts right as it rises. A perfectly vertical
             trunk was most of why an earlier version read as a spire.

             The gradient runs ACROSS the trunk, not along it. Along it reads as
             fog; across it reads as a cylinder lit from the left. -->
        <Shape x="200" y="0" name="Trunk" id="2:20">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="-30" y="502" radius="6"/>
                <StraightVertex x="-23" y="450" radius="16"/>
                <StraightVertex x="-20" y="392" radius="14"/>
                <StraightVertex x="-19" y="326" radius="14"/>
                <StraightVertex x="-15" y="258" radius="14"/>
                <StraightVertex x="-9"  y="198" radius="9"/>
                <StraightVertex x="-3"  y="158" radius="6"/>
                <StraightVertex x="15"  y="156" radius="6"/>
                <StraightVertex x="12"  y="196" radius="9"/>
                <StraightVertex x="19"  y="256" radius="14"/>
                <StraightVertex x="23"  y="324" radius="14"/>
                <StraightVertex x="25"  y="390" radius="14"/>
                <StraightVertex x="29"  y="448" radius="16"/>
                <StraightVertex x="34"  y="502" radius="6"/>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="-36" startY="320" endX="39" endY="320" name="Gradient">
                    <GradientStop colorValue="FF8B9099" position="0"/>
                    <GradientStop colorValue="FF5E636B" position="0.32"/>
                    <GradientStop colorValue="FF2B2E33" position="0.78"/>
                    <GradientStop colorValue="FF181A1D" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <LinearAnimation duration="60" name="Idle" id="2:6"/>
        <StateMachine name="SM" id="2:7">
            <StateMachineLayer name="Layer" id="2:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="2:12"/></EntryState>
                <AnimationState x="200" animationId="2:6" id="2:12"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- ================= LAYER 3: MID ================= -->
    <Artboard defaultStateMachineId="3:7" styleId="3:5" width="400" height="560" name="TreeMid" id="3:2">
        <LayoutComponentStyle name="Style" id="3:5"/>

        <Shape x="200" y="0" name="BranchMidLeft" id="3:42">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="-11" y="276" radius="2"/>
                <StraightVertex x="-52" y="234" radius="7"/>
                <StraightVertex x="-84" y="180" radius="7"/>
                <StraightVertex x="-99" y="134" radius="3"/>
                <StraightVertex x="-96" y="132" radius="3"/>
                <StraightVertex x="-76" y="174" radius="7"/>
                <StraightVertex x="-45" y="222" radius="7"/>
                <StraightVertex x="-9"  y="262" radius="2"/>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="-101" startY="134" endX="-8" endY="276" opacity="0.88" name="Gradient">
                    <GradientStop colorValue="FF8B9099" position="0"/>
                    <GradientStop colorValue="FF3D4148" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <Shape x="200" y="0" name="BranchMidRight" id="3:44">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="11" y="238" radius="2"/>
                <StraightVertex x="48" y="198" radius="7"/>
                <StraightVertex x="76" y="146" radius="7"/>
                <StraightVertex x="88" y="104" radius="3"/>
                <StraightVertex x="85" y="102" radius="3"/>
                <StraightVertex x="68" y="142" radius="7"/>
                <StraightVertex x="41" y="186" radius="7"/>
                <StraightVertex x="9"  y="224" radius="2"/>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="90" startY="104" endX="8" endY="238" opacity="0.88" name="Gradient">
                    <GradientStop colorValue="FF8B9099" position="0"/>
                    <GradientStop colorValue="FF3D4148" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <!-- The leader, continuing the trunk line to the crown. Narrower than
             the trunk top, so it reads as a continuation rather than making the
             trunk look impossibly long. -->
        <Shape x="200" y="0" name="BranchLeader" id="3:38">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="2"  y="178" radius="3"/>
                <StraightVertex x="8"  y="140" radius="4"/>
                <StraightVertex x="16" y="108" radius="3"/>
                <StraightVertex x="21" y="92"  radius="2"/>
                <StraightVertex x="24" y="93"  radius="2"/>
                <StraightVertex x="22" y="110" radius="3"/>
                <StraightVertex x="15" y="142" radius="4"/>
                <StraightVertex x="11" y="178" radius="3"/>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="1" startY="130" endX="25" endY="130" opacity="0.8" name="Gradient">
                    <GradientStop colorValue="FF8B9099" position="0"/>
                    <GradientStop colorValue="FF33373D" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <LinearAnimation duration="60" name="Idle" id="3:6"/>
        <StateMachine name="SM" id="3:7">
            <StateMachineLayer name="Layer" id="3:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="3:12"/></EntryState>
                <AnimationState x="200" animationId="3:6" id="3:12"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- ================= LAYER 2: BACK ================= -->
    <Artboard defaultStateMachineId="4:7" styleId="4:5" width="400" height="560" name="TreeBack" id="4:2">
        <LayoutComponentStyle name="Style" id="4:5"/>

        <!-- Dimmed by gradient opacity, because distance reads as loss of
             contrast rather than as a different hue. -->
        <Shape x="200" y="0" name="BranchBackLeft" id="4:34">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="-8"  y="214" radius="2"/>
                <StraightVertex x="-42" y="172" radius="6"/>
                <StraightVertex x="-62" y="122" radius="5"/>
                <StraightVertex x="-71" y="86"  radius="3"/>
                <StraightVertex x="-68" y="85"  radius="3"/>
                <StraightVertex x="-54" y="118" radius="5"/>
                <StraightVertex x="-36" y="162" radius="6"/>
                <StraightVertex x="-7"  y="202" radius="2"/>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="-73" startY="86" endX="-6" endY="214" opacity="0.46" name="Gradient">
                    <GradientStop colorValue="FF8B9099" position="0"/>
                    <GradientStop colorValue="FF2A2D32" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <Shape x="200" y="0" name="BranchBackRight" id="4:36">
            <PointsPath isClosed="true" name="Path">
                <StraightVertex x="9"  y="190" radius="2"/>
                <StraightVertex x="40" y="150" radius="6"/>
                <StraightVertex x="58" y="102" radius="5"/>
                <StraightVertex x="64" y="68"  radius="3"/>
                <StraightVertex x="61" y="67"  radius="3"/>
                <StraightVertex x="50" y="98"  radius="5"/>
                <StraightVertex x="34" y="140" radius="6"/>
                <StraightVertex x="8"  y="178" radius="2"/>
            </PointsPath>
            <Fill name="Fill">
                <LinearGradient startX="66" startY="68" endX="7" endY="190" opacity="0.46" name="Gradient">
                    <GradientStop colorValue="FF8B9099" position="0"/>
                    <GradientStop colorValue="FF2A2D32" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <LinearAnimation duration="60" name="Idle" id="4:6"/>
        <StateMachine name="SM" id="4:7">
            <StateMachineLayer name="Layer" id="4:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="4:12"/></EntryState>
                <AnimationState x="200" animationId="4:6" id="4:12"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- ================= LAYER 1: GROUND ================= -->
    <Artboard defaultStateMachineId="5:7" styleId="5:5" width="400" height="560" name="TreeGround" id="5:2">
        <LayoutComponentStyle name="Style" id="5:5"/>

        <!-- The gradient fades to transparent at both ends, which is what stops
             this reading as a UI panel. A panel has a hard edge; this has none.
             It also moves least under rotation, which is what makes it read as
             ground rather than as another branch. -->
        <Shape x="200" y="506" name="Ground" id="5:40">
            <Ellipse width="300" height="44" name="Path"/>
            <Fill name="Fill">
                <LinearGradient startX="-150" startY="0" endX="150" endY="0" opacity="0.6" name="Gradient">
                    <GradientStop colorValue="00181A1D" position="0"/>
                    <GradientStop colorValue="FF181A1D" position="0.5"/>
                    <GradientStop colorValue="00181A1D" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <LinearAnimation duration="60" name="Idle" id="5:6"/>
        <StateMachine name="SM" id="5:7">
            <StateMachineLayer name="Layer" id="5:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="5:12"/></EntryState>
                <AnimationState x="200" animationId="5:6" id="5:12"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>
</Rive>
