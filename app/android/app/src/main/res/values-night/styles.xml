<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts: the Ludeck mark on the night sky,
         the same in light and dark mode because the app itself is always dark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it starts: the app's background, never a white flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>