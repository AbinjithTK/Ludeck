# Flutter and Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/.pub-cache/
app/.pub/

# Flutter generated native scaffolding, recreated by the build
app/windows/flutter/ephemeral/
app/linux/flutter/ephemeral/
app/macos/Flutter/ephemeral/
app/ios/Flutter/ephemeral/

# Android and Gradle
**/.gradle/
**/build/
**/local.properties
**/.cxx/
*.jks
*.keystore

# Rive build output, regenerated by `rive build`
app/rive/**/build/

# IDE and editor state
.idea/
*.iml
.vscode/
*.swp

# Windows and OS noise
Thumbs.db
desktop.ini
*.pdb

# Secrets. Never commit these.
*.env
.env.*
secrets.json
service-account*.json

# Competitive intel corpus. Large, regenerable, stays local.
intel/projects*.json
intel/state*.json
intel/*.cache

# Kiro Crew CLI lock file, per-machine runtime state
.kiro/settings/.kirocrew-cli-settings.lock
